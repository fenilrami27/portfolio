# ==============================================================================
# Fenil Rami Portfolio - Root Environment Configuration Template
# ==============================================================================

# Backend Settings (see backend/.env.example for details)
SECRET_KEY=generate-a-strong-random-50-char-key-for-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,api.fenilrami.com,.vercel.app
CORS_ALLOWED_ORIGINS=https://fenilrami.com,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://fenilrami.com,https://api.fenilrami.com

# Database (Neon / Supabase Serverless Postgres)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cloudinary CDN Storage
CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>

# Cloudflare Turnstile (Anti-spam)
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Frontend API URL
VITE_API_BASE_URL=
