# ==============================================================================
# Fenil Rami Portfolio - Backend Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables as needed for local or production runs.
# Local runs with defaults require NO external accounts or cloud services.
# ==============================================================================

# Core Application Settings
# ------------------------------------------------------------------------------
# Set to True for local development, False for staging and production.
DEBUG=True

# Cryptographic signing key (generate a 50+ character random string for production).
SECRET_KEY=django-insecure-fenil-rami-portfolio-dev-secret-key-1234567890

# Comma-separated hostnames/IPs allowed to serve requests.
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Administration Portal URL Path
# ------------------------------------------------------------------------------
# Custom URL path prefix for the Django Admin dashboard (e.g. secret-admin/ in prod).
ADMIN_URL=admin/

# Database Connectivity
# ------------------------------------------------------------------------------
# Leave empty to automatically use local SQLite (db.sqlite3).
# In production, set to your PostgreSQL connection string (e.g. Neon, Supabase, Render).
# Example: postgresql://username:password@ep-sample-12345.us-east-2.aws.neon.tech/portfolio?sslmode=require
DATABASE_URL=

# Max persistent connection age in seconds (600 recommended).
CONN_MAX_AGE=600

# CORS & CSRF Trusted Origins
# ------------------------------------------------------------------------------
# Comma-separated list of origins allowed to perform cross-origin AJAX and POST requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Cloud Media Storage (Cloudinary)
# ------------------------------------------------------------------------------
# Leave empty for local development to store files in backend/media/.
# In production, set your Cloudinary URL for CDN hosting and automated responsive srcset variants.
# Format: cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>
CLOUDINARY_URL=

# Email Dispatch Configuration
# ------------------------------------------------------------------------------
# Leave EMAIL_HOST empty to use the console backend (prints outgoing emails to terminal).
# In production, supply SMTP credentials (SendGrid, Mailgun, AWS SES, or Gmail App Password).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# From email and recipient for inbound portfolio contact form inquiries.
DEFAULT_FROM_EMAIL=Fenil Rami <fenilrami1266@gmail.com>
CONTACT_NOTIFICATION_EMAIL=fenilrami1266@gmail.com

# Cloudflare Turnstile Anti-Spam Security
# ------------------------------------------------------------------------------
# Secret key for server-side Turnstile verification.
# If left empty, verification is skipped gracefully in local development.
# Obtain from https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=

# OpenAPI Schema & Swagger Documentation
# ------------------------------------------------------------------------------
# Set to True to expose /api/schema/, /api/docs/ (Swagger), and /api/redoc/.
ENABLE_API_DOCS=True

# Production SSL & Cookie Security Flags (Active when DEBUG=False)
# ------------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
