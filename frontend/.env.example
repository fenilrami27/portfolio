# ==============================================================================
# Fenil Rami Portfolio - Frontend Environment Variables
# ==============================================================================

# Backend API Base URL
# In local development, leave empty so Vite dev server proxies `/api` and `/media`
# to the local Django server (http://127.0.0.1:8000).
# In production, set to your backend domain (e.g., https://api.fenilrami.com)
VITE_API_BASE_URL=

# Standalone Local Mode Toggle
# Set to 'true' to completely bypass API network calls and run purely on local data
# (fallback.json and local data modules). Default is 'false'.
VITE_USE_LOCAL_DATA=false

# Cloudflare Turnstile Anti-Spam
# Public site key for Cloudflare Turnstile widget on the contact form.
# Leave empty in local development to bypass verification without errors.
# In production, set to your Cloudflare Turnstile site key (e.g. 0x4AAAAAA...).
VITE_TURNSTILE_SITE_KEY=
